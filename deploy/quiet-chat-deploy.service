[Unit]
Description=Quiet Chat production deployment
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/quiet-chat
ExecStart=/bin/sh -c '/bin/sh /opt/quiet-chat/deploy/scripts/materialize-lockbox-env.sh e6qg6df242g18nd4e5mv && SKIP_GIT_UPDATE=1 /bin/sh /opt/quiet-chat/deploy/deploy.sh'
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
