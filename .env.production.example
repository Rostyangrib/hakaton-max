# Copy to .env.production only on the production VM.
# Never commit real values. Generate new MAX/Yandex credentials because values
# previously sent through chat must be considered compromised.

PUBLIC_HOST=203-0-113-10.sslip.io
POSTGRES_PASSWORD=replace-with-url-safe-random-value
SESSION_SECRET=replace-with-at-least-32-random-bytes
MAX_WEBHOOK_SECRET=replace-with-random-value

MAX_BOT_TOKEN=replace-with-rotated-token
MAX_HOME_CHAT_ID=
MAX_API_BASE_URL=https://platform-api2.max.ru

YANDEX_CLOUD_FOLDER_ID=replace-with-folder-id
YANDEX_CLOUD_API_KEY=replace-with-rotated-api-key
YANDEXGPT_MODEL_URI=
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

BACKUP_BUCKET=replace-with-unique-bucket-name
AWS_ACCESS_KEY_ID=replace-with-static-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-static-secret-key

HOME_TIMEZONE=Asia/Irkutsk
WORKER_POLL_INTERVAL_MS=5000
ALERT_ANTIFLOOD_MINUTES=0
YANDEXGPT_TIMEOUT_MS=60000
SUMMARY_CACHE_TTL_SECONDS=600
SESSION_TTL_SECONDS=3600
MAX_INIT_DATA_MAX_AGE_SECONDS=600

MESSAGE_RETENTION_DAYS=30
WEBHOOK_RETENTION_DAYS=7
SUMMARY_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_SECONDS=86400
BACKUP_INTERVAL_SECONDS=86400
BACKUP_PREFIX=postgres
